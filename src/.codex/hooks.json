{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/instruction-trust-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Reinforcing repository instruction boundaries"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/git-stage-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking explicit git staging"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/commit-jargon-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking commit message"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/commit-style-guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking commit message style"
          }
        ]
      }
    ]
  }
}
