#compdef agent-sandbox
# Completion for agent-sandbox.

_agent_sandbox() {
  local -a subcommands
  local verb
  subcommands=(
    'claude:run Claude Code'
    'codex:run Codex'
    'new:start a fresh attached sandbox'
    'start:start detached'
    'run-untrusted:run repository code without host or network access'
    'stop:stop and remove'
    'export:export strict-mode volume to host repo'
    'list:all sandboxes'
    'info:image + sandbox status'
    'rebuild:docker build --no-cache'
    'enable-autostart:LaunchAgent: start at login'
    'disable-autostart:remove LaunchAgent'
    'help:usage'
  )

  _arguments -C \
    '--auto[auto permission mode]' \
    '--bypass[bypass permission mode]' \
    '--repo-setup[trusted repos only: run setup and mise install]' \
    '--signing[forward host signing agent and Git identity]' \
    '--worktree[isolate via git worktree]' \
    '--strict[isolate via docker volumes]' \
    '*--workspace[mount one or more repos (default iso only)]:repo:_files -/' \
    '--name[named slot (overrides auto-bumped suffix)]:name:' \
    '(-c --continue)'{-c,--continue}'[continue the most recent agent session]' \
    '(-r --resume)'{-r,--resume}'[resume an agent session (or picker)]:session:' \
    '1: :->cmd' \
    '*::arg:->args'

  case "$state" in
    cmd)
      _describe 'subcommand' subcommands
      ;;
    args)
      verb="$words[2]"
      if [[ "$verb" == claude || "$verb" == codex ]]; then
        if (( CURRENT == 3 )); then
          local -a agent_subcommands
          agent_subcommands=(
            'new:start a fresh attached sandbox'
            'start:start detached'
            'stop:stop and remove'
            'list:all sandboxes'
            'info:image + sandbox status'
            'rebuild:docker build --no-cache'
            'enable-autostart:LaunchAgent: start at login'
            'disable-autostart:remove LaunchAgent'
            'help:usage'
          )
          _describe 'subcommand' agent_subcommands
          return
        fi
        verb="$words[3]"
      fi
      case "$verb" in
        stop)
          _arguments \
            '--all[stop every sandbox]' \
            '--all-here[stop sandboxes for cwd repo]' \
            '--purge[also remove worktree / volumes]' \
            '--relay[stop the 1password agent relay]'
          local -a all
          all=(${(f)"$(docker ps -a --filter 'name=^agent-sandbox-' --format '{{.Names}}' 2>/dev/null)"})
          _describe 'sandbox' all
          ;;
        export)
          local -a strict
          strict=(${(f)"$(docker ps -a --filter 'name=^agent-sandbox-' --filter 'label=agent-sandbox.iso=strict' --format '{{.Names}}' 2>/dev/null)"})
          _describe 'strict sandbox' strict
          ;;
        run-untrusted)
          _arguments '--image[container image]:image:' '*:argument:_files'
          ;;
        enable-autostart|disable-autostart|start)
          _files -/
          ;;
      esac
      ;;
  esac
}

_agent_sandbox "$@"
