#!/usr/bin/env bash
# agent-sandbox - Docker-isolated coding agents, one container per repo.
#
# Default behavior: in a repo, `agent-sandbox` starts a container with
# `claude --remote-control --permission-mode acceptEdits` inside and
# attaches an interactive TTY. Selecting `codex` runs Codex instead. The
# container is ephemeral and is removed when the agent exits.
#
# Subcommands:
#   agent-sandbox [claude|codex] [--auto|--bypass] [--continue|--resume] [repo]
#                                              start + attach (default; auto)
#   agent-sandbox run-untrusted [repo] -- COMMAND
#                                              run repo code without host access
#   agent-sandbox start [--auto] [repo]      start detached (no TTY)
#   agent-sandbox stop [name|--all]          stop & remove
#   agent-sandbox list                       all sandboxes
#   agent-sandbox info                       image + sandbox status
#   agent-sandbox rebuild                    docker build --no-cache
#   agent-sandbox enable-autostart [repo]    LaunchAgent: start at login
#   agent-sandbox disable-autostart [repo]
#   agent-sandbox help

set -euo pipefail

# ANSI color helpers - only when stdout is a TTY (matches the dotfiles
# wrapper's pattern).
if [[ -t 1 ]]; then
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'
  C_YELLOW=$'\033[33m'
  C_RESET=$'\033[0m'
else
  C_DIM=""; C_BOLD=""; C_RED=""; C_YELLOW=""; C_RESET=""
fi

DISPLAY_NAME=agent-sandbox
_die()  { printf '%s%s: %s%s\n' "$C_RED" "$DISPLAY_NAME" "$*" "$C_RESET" >&2; exit 1; }
_warn() { printf '%s%s: %s%s\n' "$C_YELLOW" "$DISPLAY_NAME" "$*" "$C_RESET" >&2; }
_info() { printf '%s%s:%s %s\n' "$C_DIM" "$DISPLAY_NAME" "$C_RESET" "$*"; }
_row()  { printf '%s%-7s%s %s\n' "$C_BOLD" "$1" "$C_RESET" "$2"; }

IMAGE="agent-sandbox:latest"
NAME_PREFIX="agent-sandbox"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agent-sandbox"

# Port the 1Password-agent TCP relay listens on (host's 127.0.0.1).
# Containers reach it via host.docker.internal. Picked obscure enough to
# avoid common service collisions; override by exporting in your shell.
SANDBOX_AGENT_PORT="${SANDBOX_AGENT_PORT:-19988}"

# Multi-workspace state. Populated either by `--workspace path1 path2 ...`
# (slurps positional paths until the next --flag) or by _finalize_workspaces
# falling back to the single-repo positional / cwd. WORKSPACES[0] is the
# primary path: it sets the container name, the cwd inside the container,
# and the iOS session label. WS_LABEL is the docker-label-friendly join of
# all paths (newline-separated) used for cross-invocation matching.
WORKSPACES=()
WS_LABEL=""

RUN_REPO_SETUP=0
SIGNING=0
AGENT_KIND=claude

_require_docker() {
  command -v docker >/dev/null 2>&1 \
    || _die "docker not found on PATH (install OrbStack via brew)"
  docker info >/dev/null 2>&1 \
    || _die "docker daemon unreachable (is OrbStack running?)"
}

_mox_repo() {
  local repo="${MOX_REPO:-${XDG_DATA_HOME:-$HOME/.local/share}/mox/dotfiles}"
  [ -d "$repo" ] || _die "mox repo not found at $repo"
  printf '%s\n' "$repo"
}

_dockerfile_dir() { printf '%s/etc/sandbox\n' "$(_mox_repo)"; }

# Hash of Dockerfile + entrypoint - used to detect when a rebuild is needed.
_dockerfile_hash() {
  local dir; dir=$(_dockerfile_dir)
  [[ -f "$dir/Dockerfile" ]]   || _die "Dockerfile not found at $dir/Dockerfile"
  [[ -f "$dir/entrypoint.sh" ]] || _die "entrypoint.sh not found at $dir/entrypoint.sh"
  cat "$dir/Dockerfile" "$dir/entrypoint.sh" | shasum -a 256 | cut -d' ' -f1
}

_built_hash_file() { printf '%s/built-hash\n' "$CACHE_DIR"; }
_image_built()     { docker image inspect "$IMAGE" >/dev/null 2>&1; }

# Sanitized basename of a repo path, suitable for use in container/volume
# names. Pure bash - avoids `basename ... | tr` because basename emits a
# trailing newline that tr converts to '_', leaving spurious underscores
# at the end of the result (the visible bug: `organ.nvim_`).
_sanitize_basename() {
  local repo="$1"
  local abs; abs=$(cd "$repo" && pwd -P)
  local base="${abs##*/}"
  printf '%s\n' "${base//[^A-Za-z0-9_.-]/_}"
}

# Container name policy:
#   <base> = sanitized repo basename
#   suffix order: [-mode][-name | -N]
#   - mode suffix:  "-wt" for --worktree, "-strict" for --strict, none for default
#   - name suffix:  "-<sanitized-X>" when user passes --name X (named slot)
#   - integer N:    auto-bumped suffix when the user runs `agent-sandbox new` for
#                   parallel sessions, OR when cross-repo basename collision
#                   forces a different name. N starts at 2 (first session
#                   has no suffix).
# No path hash anywhere user-visible. Cross-repo collision is detected
# via the agent-sandbox.workspace label set at create time, then the
# wrapper auto-bumps to the next free integer suffix.
_container_name_base() {
  local repo="$1" mode="${2:-default}" name_override="${3:-}"
  local base; base=$(_sanitize_basename "$repo")
  local mode_suffix="" name_suffix=""
  case "$mode" in
    worktree) mode_suffix="-wt" ;;
    strict)   mode_suffix="-strict" ;;
  esac
  [[ "$AGENT_KIND" == "claude" ]] || mode_suffix="-${AGENT_KIND}${mode_suffix}"
  if [[ -n "$name_override" ]]; then
    name_suffix="-$(printf '%s' "$name_override" | tr -c 'A-Za-z0-9_.-' '_')"
  fi
  printf '%s-%s%s%s\n' "$NAME_PREFIX" "$base" "$mode_suffix" "$name_suffix"
}

_container_workspace_label() {
  docker container inspect -f '{{ index .Config.Labels "agent-sandbox.workspace" }}' "$1" 2>/dev/null
}

_container_agent_label() {
  docker container inspect -f '{{ index .Config.Labels "agent-sandbox.agent" }}' "$1" 2>/dev/null
}

_container_iso_label() {
  docker container inspect -f '{{ index .Config.Labels "agent-sandbox.iso" }}' "$1" 2>/dev/null
}

# Containers belonging to (repo, mode, name_override) - i.e., name matches
# the canonical base optionally followed by `-<integer>`, AND the workspace
# label matches.
# When name_override is set, the match is exact (named slots don't auto-number).
_containers_for_target() {
  local repo="$1" mode="${2:-default}" name_override="${3:-}"
  local base; base=$(_container_name_base "$repo" "$mode" "$name_override")
  local pattern
  if [[ -n "$name_override" ]]; then
    pattern="^${base}\$"
  else
    pattern="^${base}(-[0-9]+)?\$"
  fi
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    [[ "$name" =~ $pattern ]] || continue
    local ws; ws=$(_container_workspace_label "$name")
    [[ "$ws" == "$WS_LABEL" ]] && printf '%s\n' "$name"
  done < <(docker ps -a --filter "name=^${NAME_PREFIX}-" --format '{{.Names}}' 2>/dev/null)
}

_containers_for_repo() {
  local repo="$1" selected="$AGENT_KIND" agent
  for agent in claude codex; do
    AGENT_KIND="$agent"
    _containers_for_target "$repo" "default" ""
    _containers_for_target "$repo" "worktree" ""
    _containers_for_target "$repo" "strict" ""
  done
  AGENT_KIND="$selected"
}

# First name in the canonical sequence (base, base-2, base-3, ...) that no
# container currently holds. Ephemeral sandboxes never reuse a live name,
# so every existing container -- ours or another repo's -- is skipped; the
# integer suffix lets parallel sessions for the same repo coexist.
_first_unused_name() {
  local repo="$1" mode="$2" name_override="$3"
  local base; base=$(_container_name_base "$repo" "$mode" "$name_override")
  local n=1 candidate="$base"
  while _container_exists "$candidate"; do
    n=$((n + 1)); candidate="${base}-${n}"
  done
  printf '%s\n' "$candidate"
}

# Pick the container name for a fresh ephemeral sandbox. A --name slot is
# exact: if it's already taken the sandbox is still live (ephemeral
# containers self-remove on exit), so refuse rather than clobber it.
# Unnamed invocations auto-bump to the first unused integer suffix.
_create_name() {
  local repo="$1" mode="$2" name_override="$3"
  if [[ -n "$name_override" ]]; then
    local base; base=$(_container_name_base "$repo" "$mode" "$name_override")
    if _container_exists "$base"; then
      local ws; ws=$(_container_workspace_label "$base")
      if [[ -n "$ws" && "$ws" != "$WS_LABEL" ]]; then
        _die "name '$name_override' is already used by another repo: $ws
       use a different --name to disambiguate"
      fi
      _die "named sandbox '$name_override' already running; stop it first:
       agent-sandbox stop $base"
    fi
    printf '%s\n' "$base"; return
  fi
  _first_unused_name "$repo" "$mode" ""
}

_worktree_path() {
  local repo="$1" name="$2"
  local abs base hash short
  abs=$(cd "$repo" && pwd -P)
  base=$(_sanitize_basename "$repo")
  hash=$(printf '%s' "$abs" | shasum -a 256 | cut -c1-8)
  short="${name#${NAME_PREFIX}-}"
  printf '%s/worktrees/%s-%s-%s\n' "$CACHE_DIR" "$base" "$hash" "$short"
}

_worktree_branch() {
  local name="$2" short="${name#${NAME_PREFIX}-}"
  printf 'agent-sandbox/%s\n' "$short"
}

# Strict-mode volume names. Derived from the container name so they
# track the same disambiguation scheme (--name suffix, etc.). The
# workspace volume's host-repo label is checked at seed time for
# cross-repo collision (see _ensure_strict_volumes).
_strict_ws_volume() {
  printf '%s-ws\n' "$1"
}
_strict_cl_volume() {
  printf '%s-cl\n' "$1"
}

# Per-slot agent home, mounted at the host home path. Sandbox-owned: host
# content reaches it only through the explicit binds in _run_args.
_sandbox_home_path() {
  printf '%s/agent-sandbox/home/%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}" "$1"
}

# Sandbox docs target. Outside the agent state directory, which is slot-local.
_agent_docs_path() {
  printf '%s/agent-docs\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
}

_ensure_sandbox_home() {
  local dir; dir=$(_sandbox_home_path "$1")
  mkdir -p "$dir" "$(_agent_docs_path)"
  [[ "$AGENT_KIND" == codex ]] && { _seed_codex_home "$dir"; return; }
  mkdir -p "$dir/.claude"

  local ws
  for ws in "${WORKSPACES[@]}"; do
    mkdir -p "$HOME/.claude/projects/$(printf '%s' "$ws" | tr '/.' '--')"
  done

  local f
  for f in .claude.json; do
    [[ -e "$dir/$f" ]] && continue
    if [[ -f "$HOME/$f" ]]; then cp "$HOME/$f" "$dir/$f"; else printf '{}\n' > "$dir/$f"; fi
  done
  # Re-copied every launch: the host stays authoritative, and a session cannot
  # persist edits. A model change inside a sandbox does not survive recreation.
  for f in settings.json settings.local.json; do
    [[ -f "$HOME/.claude/$f" ]] && cp -f "$HOME/.claude/$f" "$dir/.claude/$f"
  done

  # Metadata beside cache/ is rewritten at startup, so the slot gets its own.
  if [[ -d "$HOME/.claude/plugins" ]]; then
    mkdir -p "$dir/.claude/plugins/cache"
    for f in config.json installed_plugins.json known_marketplaces.json plugin-catalog-cache.json; do
      [[ -e "$dir/.claude/plugins/$f" ]] && continue
      [[ -f "$HOME/.claude/plugins/$f" ]] && cp "$HOME/.claude/plugins/$f" "$dir/.claude/plugins/$f"
    done
  fi

  # Recreated each launch so a session cannot durably replace them.
  for f in CLAUDE.md:instructions.md hooks:hooks skills:skills; do
    rm -rf "$dir/.claude/${f%%:*}"
    ln -sfn "../.agents/${f##*:}" "$dir/.claude/${f%%:*}"
  done
}

# Codex equivalent. config.toml carries the hook trust ledger, so it is copied
# rather than shared.
_seed_codex_home() {
  local dir="$1" f
  mkdir -p "$dir/.codex/plugins/cache"
  for f in config.toml config.json hooks.json instructions.md installation_id version.json; do
    [[ -f "$HOME/.codex/$f" ]] && cp -f "$HOME/.codex/$f" "$dir/.codex/$f"
  done
  for f in rules skills; do
    [[ -d "$HOME/.codex/$f" ]] || continue
    rm -rf "$dir/.codex/$f"
    cp -R "$HOME/.codex/$f" "$dir/.codex/$f"
  done
  rm -rf "$dir/.codex/AGENTS.md"
  ln -sfn ../.agents/instructions.md "$dir/.codex/AGENTS.md"
}

# Directory symlinks inside a workspace, resolved to their real paths. A view
# assembled from links - a holt hub project, whose code/, docs/ and assets/ all
# point elsewhere - is useless in a container unless the targets come with it.
# Depth 2 covers both the top-level links and code/<repo>. Results land in
# LINK_TARGETS, deduped, with any target that contains another dropped so a
# parent and its child are not both mounted.
_resolve_workspace_links() {
  local ws="$1" link target raw candidate seen=()
  LINK_TARGETS=()
  while IFS= read -r link; do
    target=$(cd "$link" 2>/dev/null && pwd -P) || continue
    # The physical path is what docker needs; the literal target is what the
    # link inside the container will point at. They differ wherever a parent
    # is itself a symlink (/var -> /private/var on macOS), and the link only
    # resolves in the container if both are present.
    raw=$(readlink "$link")
    for candidate in "$target" "$raw"; do
      [[ "$candidate" == /* ]] || continue
      case "$candidate" in
        "$ws" | "$ws"/* | / | "$HOME") continue ;;
      esac
      [[ "$ws" == "$candidate"/* ]] && continue
      seen+=( "$candidate" )
    done
  done < <(find "$ws" -mindepth 1 -maxdepth 2 -type l 2>/dev/null)

  local a b keep
  while IFS= read -r a; do
    keep=1
    for b in ${LINK_TARGETS[@]+"${LINK_TARGETS[@]}"}; do
      [[ "$a" == "$b"/* ]] && { keep=0; break; }
    done
    ((keep)) && LINK_TARGETS+=( "$a" )
  done < <(printf '%s\n' ${seen[@]+"${seen[@]}"} | LC_ALL=C sort -u)
}

_container_exists()  { docker container inspect "$1" >/dev/null 2>&1; }
_container_running() {
  [[ "$(docker container inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == "true" ]]
}

# Resolve the target repo: explicit arg if given, else git toplevel of
# cwd, else cwd. Returns absolute LOGICAL path (preserves symlinks in
# the path the user typed). Matches host claude-code's path-keying
# convention: ~/.claude/projects/ entries reflect the path as invoked,
# not the physical resolution. Keeping our path consistent means
# host-claude and sandbox-claude share per-project memory rather than
# fragmenting it.
_resolve_repo() {
  local arg="${1:-}"
  if [[ -n "$arg" ]]; then
    [[ -d "$arg" ]] || _die "no such directory: $arg"
    (cd "$arg" && pwd)
    return
  fi
  local top
  if top=$(git rev-parse --show-toplevel 2>/dev/null); then
    printf '%s\n' "$top"
  else
    pwd
  fi
}

# Visible cues that this terminal is inside a sandbox. starship's
# [custom.sandbox] indicator only renders in shell prompts - but
# agent-sandbox drops straight into the agent UI, with no shell visible.
_print_banner() {
  local name="$1" repo="$2" label="${3:-}" perm="${4:-?}" iso="${5:-?}"
  if [[ -t 1 ]]; then
    # OSC 0: terminal title + icon name.
    if [[ -n "$label" ]]; then
      printf '\033]0;%s\007' "$label"
    else
      printf '\033]0;🛡 %s - %s\007' "$DISPLAY_NAME" "$name"
    fi
  fi
  printf '%s=====================================================%s\n' "$C_DIM" "$C_RESET"
  printf '%s🛡  %s%s - %s\n' "$C_BOLD" "$DISPLAY_NAME" "$C_RESET" "$name"
  if [[ ${#WORKSPACES[@]} -gt 1 ]]; then
    printf '   workspace: %s (primary)\n' "${WORKSPACES[0]}"
    local i
    for ((i = 1; i < ${#WORKSPACES[@]}; i++)); do
      printf '              %s\n' "${WORKSPACES[i]}"
    done
  else
    printf '   workspace: %s\n' "$repo"
  fi
  [[ "$AGENT_KIND" == "claude" && -n "$label" ]] && printf '   ios label: %s\n' "$label"
  if [[ "$perm" != "?" || "$iso" != "?" ]]; then
    printf '   mode:      perm=%s iso=%s repo-setup=%s signing=%s\n' "$perm" "$iso" "$RUN_REPO_SETUP" "$SIGNING"
  fi
  if [[ "$AGENT_KIND" == "claude" ]]; then
    printf '   detach:    Ctrl-p Ctrl-q (drive from the Claude app; removed on exit)\n'
  else
    printf '   exit:      quit Codex to remove the container\n'
  fi
  printf '%s=====================================================%s\n' "$C_DIM" "$C_RESET"
}

# Agent CLI args. The label (when given) is passed via `claude --name`
# so the iOS app shows a stable, distinguishable session label instead
# of the auto-derived first-prompt-summary that drifts over time.
_agent_args() {
  local perm="$1" label="${2:-}"
  local args=()
  case "$AGENT_KIND" in
    claude)
      args=( --remote-control )
      [[ -n "$label" ]] && args+=( --name "$label" )
      case "$perm" in
        auto) args+=( --permission-mode acceptEdits ) ;;
        bypass) args+=( --dangerously-skip-permissions ) ;;
        *) _die "unknown permission mode: $perm" ;;
      esac
      [[ ${#RESUME_FLAGS[@]} -gt 0 ]] && args+=( "${RESUME_FLAGS[@]}" )
      ;;
    codex)
      case "$perm" in
        auto) args+=( --sandbox workspace-write --ask-for-approval on-request ) ;;
        bypass) args+=( --dangerously-bypass-approvals-and-sandbox ) ;;
        *) _die "unknown permission mode: $perm" ;;
      esac
      case "${RESUME_FLAGS[0]:-}" in
        --continue) args=( resume --last "${args[@]}" ) ;;
        --resume)
          if [[ ${#RESUME_FLAGS[@]} -gt 1 ]]; then
            args=( resume "${RESUME_FLAGS[1]}" "${args[@]}" )
          else
            args=( resume "${args[@]}" )
          fi
          ;;
      esac
      ;;
  esac
  args+=( ${AGENT_EXTRA[@]+"${AGENT_EXTRA[@]}"} )
  printf '%s\n' "${args[@]}"
}

# iOS-app-visible label. Prefix with 🛡 so sandbox sessions are
# instantly distinguishable from non-sandbox ones in the session list.
_session_label_for() {
  local container_name="$1" name_override="${2:-}"
  if [[ -n "$name_override" ]]; then
    printf '🛡 %s\n' "$name_override"
    return
  fi
  # Strip the wrapper prefix so the label is just `<base>[-mode][-N]`.
  local short="${container_name#${NAME_PREFIX}-}"
  printf '🛡 %s\n' "$short"
}

# Build the docker run mount/env arg list for a given mode.
#
# default:  bind-mount the repo at its host path inside the container.
#           Mirroring the path matters because Claude's per-project
#           session memory is keyed at ~/.claude/projects/<path>/ - if
#           we mounted at /workspace the in-sandbox memory would split
#           into a separate dir from the host's. Mirroring keeps memory
#           continuous between sandbox and non-sandbox sessions.
# worktree: the git worktree is mounted at the *host repo's* path so
#           memory keys to the project, not the throwaway worktree.
# strict:   the workspace volume is also mounted at the host repo's
#           path - the volume's contents diverge from host but the path
#           encoding stays consistent inside the container.
_run_args() {
  local repo="$1" name="$2" mode="${3:-default}"
  local args=(
    --name     "$name"
    --hostname "$name"
    --label    "agent-sandbox.workspace=$WS_LABEL"
    --label    "agent-sandbox.iso=$mode"
    --label    "agent-sandbox.agent=$AGENT_KIND"
    -e AGENT_SANDBOX=1
    -w "$repo"
  )
  ((RUN_REPO_SETUP)) && args+=( -e ASB_REPO_SETUP=1 )

  # Identity by value as GIT_CONFIG_* env config - unlike GIT_AUTHOR_*, a
  # `git config user.email` query resolves it, so agents' identity preflight
  # passes. The config directory itself stays out: it also holds credential
  # helpers and an account token. Resolved against the repo so includeIf
  # picks the same account as on the host.
  local git_name git_email git_n=0
  git_name=$(git -C "$repo" config user.name 2>/dev/null || true)
  git_email=$(git -C "$repo" config user.email 2>/dev/null || true)
  if [[ -n "$git_name" ]]; then
    args+=( -e "GIT_CONFIG_KEY_$git_n=user.name" -e "GIT_CONFIG_VALUE_$git_n=$git_name" )
    git_n=$((git_n + 1))
  fi
  if [[ -n "$git_email" ]]; then
    args+=( -e "GIT_CONFIG_KEY_$git_n=user.email" -e "GIT_CONFIG_VALUE_$git_n=$git_email" )
    git_n=$((git_n + 1))
  fi
  ((git_n)) && args+=( -e "GIT_CONFIG_COUNT=$git_n" )
  [[ -f "$HOME/.config/git/ignore" ]] &&
    args+=( -v "$HOME/.config/git/ignore":/home/claude/.config/git/ignore:ro )

  # File by file so the token beside them never enters.
  if ((SIGNING)); then
    local gf
    for gf in config allowed_signers personal.inc identities.local.inc; do
      [[ -f "$HOME/.config/git/$gf" ]] &&
        args+=( -v "$HOME/.config/git/$gf":/home/claude/.config/git/"$gf":ro )
    done
    for gf in "$HOME"/.config/git/id-*.inc; do
      [[ -f "$gf" ]] && args+=( -v "$gf":/home/claude/.config/git/"${gf##*/}":ro )
    done
  fi

  # SSH commit-signing via the host's 1Password agent. Two transports:
  #
  #   macOS host: TCP relay (host-side socat started in
  #               _ensure_signing_relay forwards 127.0.0.1:PORT ->
  #               1Password Unix socket). Container reaches via
  #               host.docker.internal and starts its own socat in
  #               entrypoint.sh to re-present TCP as a Unix socket
  #               for ssh-keygen. Bind-mounting macOS Unix sockets
  #               into Linux containers fails the connect step.
  #
  #   Linux host: direct Unix socket bind-mount. Linux-to-Linux Unix
  #               sockets carry the connection just fine; no relay or
  #               in-container socat needed.
  #
  # Skipped silently when 1Password's agent isn't running (commits
  # go out unsigned, same as a host without 1Password).
  local op_sock=""
  ((SIGNING)) && op_sock=$(_op_agent_socket)
  if [[ -n "$op_sock" && -S "$op_sock" ]]; then
    case "$(uname)" in
      Darwin)
        args+=(
          -e "SANDBOX_AGENT_HOST=host.docker.internal"
          -e "SANDBOX_AGENT_PORT=${SANDBOX_AGENT_PORT}"
        )
        ;;
      Linux)
        args+=(
          -v "$op_sock":/run/host-1password-agent.sock
          -e "SANDBOX_AGENT_SOCK=/run/host-1password-agent.sock"
        )
        ;;
    esac
  fi

  # A per-slot directory at the host home path: claude-code writes its config
  # temp file beside the realpath, which must be writable and not a mountpoint.
  # ~/.agents is mounted at both paths because ~/.claude symlinks into it by
  # host-absolute path while settings.json invokes hooks as $HOME/.agents.
  if [[ "$mode" != "strict" ]]; then
    args+=( -e "HOST_HOME=$HOME" -e "SANDBOX_AGENT_KIND=$AGENT_KIND" )
    args+=( -v "$(_sandbox_home_path "$name")":"$HOME" )
    [[ -d "$HOME/.agents" ]] && args+=( -v "$HOME/.agents":"$HOME/.agents":ro )
    # Specs and plans written from a sandbox outside a hub project land here.
    # The agent state directory is sandbox-local, so without this mount they
    # would vanish with the slot instead of reaching the host.
    local agent_docs; agent_docs=$(_agent_docs_path)
    [[ -d "$agent_docs" ]] && args+=( -v "$agent_docs":"$agent_docs" )
    local shared
    if [[ "$AGENT_KIND" == "claude" ]]; then
      [[ -d "$HOME/.claude/plugins/cache" ]] &&
        args+=( -v "$HOME/.claude/plugins/cache":"$HOME/.claude/plugins/cache":ro )
      for shared in history.jsonl .credentials.json; do
        [[ -e "$HOME/.claude/$shared" ]] &&
          args+=( -v "$HOME/.claude/$shared":"$HOME/.claude/$shared" )
      done
      # Only the launched workspaces' own history and memory, not all projects.
      local ws enc pdir
      for ws in "${WORKSPACES[@]}"; do
        enc=$(printf '%s' "$ws" | tr '/.' '--')
        pdir="$HOME/.claude/projects/$enc"
        [[ -d "$pdir" ]] || continue
        args+=( -v "$pdir":"$pdir" )
      done
    else
      [[ -d "$HOME/.codex/plugins/cache" ]] &&
        args+=( -v "$HOME/.codex/plugins/cache":"$HOME/.codex/plugins/cache":ro )
      for shared in auth.json history.jsonl sessions; do
        [[ -e "$HOME/.codex/$shared" ]] &&
          args+=( -v "$HOME/.codex/$shared":"$HOME/.codex/$shared" )
      done
    fi
  fi

  # Needed in every mode, strict included, or its guards never run.
  [[ -d "$HOME/.agents" ]] && args+=( -v "$HOME/.agents":/home/claude/.agents:ro )

  case "$mode" in
    default)
      # One bind per explicitly selected workspace path.
      local ws
      local target
      for ws in "${WORKSPACES[@]}"; do
        args+=( -v "$ws":"$ws" )
        _resolve_workspace_links "$ws"
        for target in ${LINK_TARGETS[@]+"${LINK_TARGETS[@]}"}; do
          args+=( -v "$target":"$target" )
        done
        # git runs these on the host afterwards. config too, not just hooks:
        # core.hooksPath, filter and diff entries all execute.
        [[ -d "$ws/.git/hooks" ]] && args+=( -v "$ws/.git/hooks":"$ws/.git/hooks":ro )
        [[ -f "$ws/.git/config" ]] && args+=( -v "$ws/.git/config":"$ws/.git/config":ro )
        # Project agent config declares hooks and MCP servers a host session
        # would honor.
        [[ -d "$ws/.claude" ]] && args+=( -v "$ws/.claude":"$ws/.claude":ro )
        [[ -f "$ws/.mcp.json" ]] && args+=( -v "$ws/.mcp.json":"$ws/.mcp.json":ro )
      done
      ;;
    worktree)
      local wt; wt=$(_worktree_path "$repo" "$name")
      args+=( -v "$wt":"$repo" )
      ;;
    strict)
      args+=( -v "$(_strict_ws_volume "$name")":"$repo"
              -v "$(_strict_cl_volume "$name")":/home/claude/.claude )
      ;;
    *) _die "unknown isolation mode: $mode" ;;
  esac
  printf '%s\n' "${args[@]}"
}

# Resolve the host's 1Password SSH agent socket per-OS. Empty string
# when 1Password isn't running (or not installed). Linux and macOS
# place the socket at different documented paths.
_op_agent_socket() {
  case "$(uname)" in
    Darwin) printf '%s\n' "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ;;
    Linux)  printf '%s\n' "$HOME/.1password/agent.sock" ;;
    *)      printf '\n' ;;
  esac
}

# macOS-only: bridge 1Password's Unix agent socket to TCP
# 127.0.0.1:$SANDBOX_AGENT_PORT so containers can reach it via
# host.docker.internal. Bind-mounting macOS sockets directly into
# Linux containers doesn't carry the protocol (the file mounts but
# `Connection refused` on connect); TCP relay sidesteps the VM
# boundary. Started lazily on first sandbox launch and persists
# across invocations. Stop with: pkill -f "socat.*${SANDBOX_AGENT_PORT}".
#
# Linux hosts skip this entirely - the wrapper bind-mounts the agent
# socket directly into the container instead, since Linux-to-Linux
# Unix socket forwarding works fine.
_ensure_signing_relay() {
  [[ "$(uname)" == "Darwin" ]] || return 0
  local op_sock; op_sock=$(_op_agent_socket)
  [[ -S "$op_sock" ]] || return 0
  command -v socat >/dev/null 2>&1 || {
    _warn "socat not installed; sandbox commits will be unsigned (brew install socat)"
    return 0
  }
  if lsof -nP -iTCP:"$SANDBOX_AGENT_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    return 0
  fi
  local logdir="$CACHE_DIR/relay"
  mkdir -p "$logdir"
  nohup socat \
    "TCP-LISTEN:${SANDBOX_AGENT_PORT},bind=127.0.0.1,fork,reuseaddr" \
    "UNIX-CONNECT:${op_sock}" \
    >"$logdir/relay.log" 2>&1 &
  disown
  local i
  for i in 1 2 3 4 5; do
    if lsof -nP -iTCP:"$SANDBOX_AGENT_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
      _info "started 1password agent relay on 127.0.0.1:${SANDBOX_AGENT_PORT}"
      return 0
    fi
    sleep 0.2
  done
  _warn "agent relay didn't come up within 1s (see $logdir/relay.log); commits inside sandbox may be unsigned"
}

# --worktree: create a fresh git worktree on a throwaway branch so
# The agent works in a checkout that's disjoint from the user's main one.
_ensure_worktree() {
  local repo="$1" name="$2"
  [[ -d "$repo/.git" || -f "$repo/.git" ]] || _die "$repo is not a git repo (--worktree requires git)"
  local wt branch
  wt=$(_worktree_path "$repo" "$name")
  branch=$(_worktree_branch "$repo" "$name")
  if [[ -d "$wt" ]]; then return 0; fi
  mkdir -p "$(dirname "$wt")"
  # If the branch already exists (from a prior worktree that was rm'd
  # without `git worktree remove`), reuse it instead of erroring.
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo" worktree add "$wt" "$branch"
  else
    git -C "$repo" worktree add -b "$branch" "$wt"
  fi
  _info "worktree: $wt (branch $branch)"
}

# --strict: ensure both volumes exist and are seeded. Seeding only
# happens once (when the volume is first created); subsequent starts
# reuse the volume so Claude's in-progress work survives container
# recreation.
_ensure_strict_volumes() {
  local repo="$1" name="$2"
  local ws cl
  ws=$(_strict_ws_volume "$name")
  cl=$(_strict_cl_volume "$name")

  if ! docker volume inspect "$ws" >/dev/null 2>&1; then
    _info "creating + seeding $ws from $repo"
    docker volume create \
      --label "agent-sandbox.host-repo=${repo}" \
      --label "agent-sandbox.kind=workspace" \
      "$ws" >/dev/null
    docker run --rm --user 0 \
      -v "$repo":/src:ro \
      -v "$ws":/dst \
      "$IMAGE" \
      sh -c 'cp -a /src/. /dst/ && chown -R 1000:1000 /dst' >/dev/null
  fi

  if ! docker volume inspect "$cl" >/dev/null 2>&1; then
    _info "creating $cl"
    docker volume create \
      --label "agent-sandbox.kind=claude-home" \
      "$cl" >/dev/null
    if [[ -d "$HOME/.claude" ]]; then
      _info "seeding $cl from ~/.claude (one time only)"
      docker run --rm --user 0 \
        -v "$HOME/.claude":/src:ro \
        -v "$cl":/dst \
        "$IMAGE" \
        sh -c 'cp -a /src/. /dst/ && chown -R 1000:1000 /dst' >/dev/null
    fi
    # Also seed ~/.claude.json into the volume root as `.asb-claude.json`.
    # The entrypoint symlinks `$HOME/.claude.json` to it so reads/writes
    # by claude inside the sandbox persist in the volume rather than
    # bouncing off the ephemeral image filesystem.
    if [[ -f "$HOME/.claude.json" ]]; then
      _info "seeding $cl with ~/.claude.json (as .asb-claude.json)"
      docker run --rm --user 0 \
        -v "$HOME/.claude.json":/seed.json:ro \
        -v "$cl":/dst \
        "$IMAGE" \
        sh -c 'cp /seed.json /dst/.asb-claude.json && chown 1000:1000 /dst/.asb-claude.json' >/dev/null
    fi
  fi
}

_ensure_image() {
  mkdir -p "$CACHE_DIR"
  local current built
  current=$(_dockerfile_hash)
  built=$(cat "$(_built_hash_file)" 2>/dev/null || echo "")

  if ! _image_built; then
    _info "image $IMAGE not built yet - building"
    _build_image
    return
  fi

  if [[ "$current" != "$built" ]]; then
    _warn "image inputs (Dockerfile or entrypoint.sh) changed since last build."
    if [[ -t 0 ]]; then
      printf 'Rebuild now? [Y/n] '
      local ans; read -r ans
      if [[ -z "$ans" || "$ans" =~ ^[Yy] ]]; then
        _build_image
      else
        _info "skipping rebuild; using stale image"
      fi
    else
      _info "non-interactive; skipping rebuild"
    fi
  fi
}

_build_image() {
  local dir; dir=$(_dockerfile_dir)
  _info "docker build -t $IMAGE $dir"
  docker build -t "$IMAGE" "$dir"
  _dockerfile_hash > "$(_built_hash_file)"
}

# subcommands

# Parse common flags: permission mode + isolation mode. Sets the
# globals PERM_MODE and ISO_MODE; consumed positional args are shifted
# off via the caller. Stops at the first non-flag argument.
_parse_common_flags() {
  PERM_MODE="auto"
  ISO_MODE="default"
  NAME_OVERRIDE=""
  RUN_REPO_SETUP=0
  SIGNING=0
  WORKSPACES=()
  RESUME_FLAGS=()
  AGENT_EXTRA=()
  while (($#)); do
    case "$1" in
      --auto)     PERM_MODE="auto";   shift ;;
      --bypass)   PERM_MODE="bypass"; shift ;;
      --worktree) ISO_MODE="worktree"; shift ;;
      --strict)   ISO_MODE="strict";  shift ;;
      --repo-setup) RUN_REPO_SETUP=1; shift ;;
      --signing) SIGNING=1; shift ;;
      --name)     NAME_OVERRIDE="${2:-}"; [[ -z "$NAME_OVERRIDE" ]] && _die "--name requires an argument"; shift 2 ;;
      --name=*)   NAME_OVERRIDE="${1#--name=}"; shift ;;
      # Resume passthrough. --continue and --resume reach claude as-is so
      # the sandboxed session loads prior conversation history from
      # ~/.claude/projects/<encoded-cwd>/. --resume may take an optional
      # session-id; if the next arg looks like a uuid, consume it too.
      --continue|-c) RESUME_FLAGS=( --continue ); shift ;;
      --resume|-r)
        shift
        if (($#)) && { [[ "$1" =~ ^[0-9a-fA-F-]+$ ]] || [[ ! -d "$1" && "$1" != -* ]]; }; then
          RESUME_FLAGS=( --resume "$1" ); shift
        else
          RESUME_FLAGS=( --resume )
        fi
        ;;
      --resume=*) RESUME_FLAGS=( --resume "${1#--resume=}" ); shift ;;
      --workspace)
        shift
        # Slurp positional paths until the next flag or end. Use `--` after
        # the last workspace path if you also want to pass a positional repo
        # (rare; --workspace and the [repo] positional don't normally mix).
        while (($#)) && [[ "$1" != -* ]]; do
          [[ -d "$1" ]] || _die "--workspace path doesn't exist: $1"
          WORKSPACES+=( "$(cd "$1" && pwd)" )
          shift
        done
        [[ ${#WORKSPACES[@]} -gt 0 ]] || _die "--workspace requires at least one path"
        ;;
      # Left in place so the split below sees it: everything after it is agent
      # arguments, whether or not a positional repo came first.
      --) break ;;
      -*) _die "unknown option: $1" ;;
      *)  break ;;
    esac
  done
  REMAINING=( "$@" )

  local i
  for i in "${!REMAINING[@]}"; do
    if [[ "${REMAINING[$i]}" == "--" ]]; then
      AGENT_EXTRA=( "${REMAINING[@]:i+1}" )
      REMAINING=( "${REMAINING[@]:0:i}" )
      break
    fi
  done

  if ((RUN_REPO_SETUP && SIGNING)); then
    _die "--repo-setup and --signing cannot be combined"
  fi
  if [[ "$AGENT_KIND" == "codex" && "$ISO_MODE" == "strict" ]]; then
    _die "--strict is not yet supported for Codex; use default or --worktree"
  fi

  if [[ ${#WORKSPACES[@]} -gt 1 ]] && [[ "$ISO_MODE" != "default" ]]; then
    _die "--workspace with multiple paths is only supported in default iso mode (no --worktree / --strict)"
  fi
}

# Populate WORKSPACES (from positional / cwd if --workspace was not given)
# and compute WS_LABEL. Call this after _parse_common_flags in every
# cmd_* that needs to act on a repo path.
_finalize_workspaces() {
  if [[ ${#WORKSPACES[@]} -eq 0 ]]; then
    WORKSPACES=( "$(_resolve_repo "${REMAINING[0]:-}")" )
  fi
  local IFS=$'\n'
  WS_LABEL="${WORKSPACES[*]}"
}

cmd_run_untrusted() {
  local image="$IMAGE" repo=""
  while (($#)); do
    case "$1" in
      --image) image="${2:-}"; [[ -z "$image" ]] && _die "--image requires an argument"; shift 2 ;;
      --image=*) image="${1#--image=}"; shift ;;
      --) shift; break ;;
      -*) _die "unknown run-untrusted option: $1" ;;
      *) [[ -z "$repo" ]] || _die "run-untrusted accepts one repository path"; repo="$1"; shift ;;
    esac
  done
  (($#)) || _die "run-untrusted requires a command after --"
  repo=$(_resolve_repo "$repo")
  _require_docker
  if [[ "$image" == "$IMAGE" ]]; then
    _ensure_image
  else
    docker image inspect "$image" >/dev/null 2>&1 || _die "image not found: $image"
  fi
  docker run --rm \
    --network none \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --read-only \
    --memory 4g \
    --cpus 4 \
    --pids-limit 512 \
    --tmpfs /tmp:rw,nosuid,nodev \
    --tmpfs /workspace:rw,nosuid,nodev,size=4g,uid=1000,gid=1000,mode=0700 \
    -e HOME=/tmp/home \
    -v "$repo":/src:ro \
    -w /workspace \
    --entrypoint sh \
    "$image" -c 'mkdir -p "$HOME"; cp -a /src/. /workspace/; exec "$@"' sh "$@"
}

# cmd_default - create a fresh ephemeral sandbox and attach. The
# container is removed when the agent exits (docker run --rm). There is no
# reattach: detach with Ctrl-p Ctrl-q to drive the running session from
# the Claude app, or resume a past conversation in a new container with
# --continue / --resume. Concurrent sessions for the same repo coexist
# under auto-bumped name suffixes (base, base-2, ...).
cmd_default() {
  _parse_common_flags "$@"
  _finalize_workspaces
  local repo="${WORKSPACES[0]}"
  _require_docker
  _ensure_image
  ((SIGNING)) && _ensure_signing_relay

  local name; name=$(_create_name "$repo" "$ISO_MODE" "$NAME_OVERRIDE")
  case "$ISO_MODE" in
    worktree) _ensure_worktree "$repo" "$name" ;;
    strict)   _ensure_strict_volumes "$repo" "$name" ;;
  esac
  [[ "$ISO_MODE" == strict ]] || _ensure_sandbox_home "$name"
  local label; label=$(_session_label_for "$name" "$NAME_OVERRIDE")

  _info "creating $name (perm=$PERM_MODE iso=$ISO_MODE)"
  local run_args=() c_args=() line
  while IFS= read -r line || [[ -n "$line" ]]; do run_args+=("$line"); done < <(_run_args "$repo" "$name" "$ISO_MODE")
  while IFS= read -r line || [[ -n "$line" ]]; do c_args+=("$line"); done < <(_agent_args "$PERM_MODE" "$label")
  _print_banner "$name" "$repo" "$label" "$PERM_MODE" "$ISO_MODE"
  # The pane's foreground process is docker, so herdr cannot identify the
  # agent by process name. HERDR_AGENT on the docker command is herdr's
  # documented wrapper hint (honored on macOS from herdr 0.7.5): it selects
  # the agent's screen manifest and herdr tracks live state from the terminal
  # output passing through the container.
  local rc=0
  if HERDR_AGENT="$AGENT_KIND" docker run --rm -it "${run_args[@]}" "$IMAGE" "$AGENT_KIND" "${c_args[@]}"; then rc=0; else rc=$?; fi
  return "$rc"
}

# cmd_start - create a fresh detached ephemeral sandbox (no TTY). Used by
# autostart and to launch a phone-drivable session. Removed when the agent
# exits, same as the attached default.
cmd_start() {
  _parse_common_flags "$@"
  _finalize_workspaces
  local repo="${WORKSPACES[0]}"
  _require_docker
  _ensure_image
  ((SIGNING)) && _ensure_signing_relay

  local name; name=$(_create_name "$repo" "$ISO_MODE" "$NAME_OVERRIDE")
  case "$ISO_MODE" in
    worktree) _ensure_worktree "$repo" "$name" ;;
    strict)   _ensure_strict_volumes "$repo" "$name" ;;
  esac
  [[ "$ISO_MODE" == strict ]] || _ensure_sandbox_home "$name"
  local label; label=$(_session_label_for "$name" "$NAME_OVERRIDE")
  _info "creating detached $name (perm=$PERM_MODE iso=$ISO_MODE)"
  local run_args=() c_args=() line
  while IFS= read -r line || [[ -n "$line" ]]; do run_args+=("$line"); done < <(_run_args "$repo" "$name" "$ISO_MODE")
  while IFS= read -r line || [[ -n "$line" ]]; do c_args+=("$line"); done < <(_agent_args "$PERM_MODE" "$label")
  docker run -d --rm "${run_args[@]}" "$IMAGE" "$AGENT_KIND" "${c_args[@]}" >/dev/null
  _info "started $name"
}

cmd_stop() {
  local purge=0 scope="" arg="" stop_relay=0
  while (($#)); do
    case "$1" in
      --purge)     purge=1; shift ;;
      --all)       scope="all"; shift ;;
      --all-here)  scope="here"; shift ;;
      --relay)     stop_relay=1; shift ;;
      *)           arg="$1"; shift; break ;;
    esac
  done

  # --relay: kill the host-side 1Password agent socat relay. Doesn't
  # touch any containers. The relay is a persistent service started
  # lazily by _ensure_signing_relay; this is the explicit stop.
  if (( stop_relay )); then
    if pkill -f "socat.*${SANDBOX_AGENT_PORT}.*UNIX-CONNECT" >/dev/null 2>&1; then
      _info "stopped 1password agent relay on 127.0.0.1:${SANDBOX_AGENT_PORT}"
    else
      _info "no 1password agent relay running"
    fi
    return 0
  fi

  _require_docker

  if [[ "$scope" == "all" ]]; then
    local containers; containers=$(docker ps -aq --filter "name=^${NAME_PREFIX}-")
    if [[ -z "$containers" ]]; then _info "no sandboxes to stop"; return 0; fi
    docker rm -f $containers >/dev/null
    _info "stopped all sandboxes"
    return 0
  fi

  if [[ "$scope" == "here" ]]; then
    local repo; repo=$(_resolve_repo)
    local matches; matches=$(_containers_for_repo "$repo")
    [[ -z "$matches" ]] && { _info "no sandboxes for $repo"; return 0; }
    while IFS= read -r n; do
      [[ -z "$n" ]] && continue
      docker rm -f "$n" >/dev/null && _info "stopped $n"
    done <<< "$matches"
    return 0
  fi

  # No scope: explicit name OR pick from cwd's sandboxes.
  local name="$arg" repo=""
  if [[ -z "$name" ]]; then
    repo=$(_resolve_repo)
    local matches; matches=$(_containers_for_repo "$repo")
    [[ -z "$matches" ]] && _die "no sandbox for $repo"
    local count; count=$(printf '%s\n' "$matches" | grep -c .)
    if (( count == 1 )); then
      name="$matches"
    else
      command -v fzf >/dev/null 2>&1 \
        || _die "$count sandboxes here; pick one: $(printf '%s\n' "$matches" | tr '\n' ' ')"
      name=$(printf '%s\n' "$matches" \
        | fzf --height 40% --reverse --prompt 'stop> ' --no-info)
      [[ -z "$name" ]] && exit 0
    fi
  fi

  _container_exists "$name" || _die "$name does not exist"
  [[ -z "$repo" ]] && repo=$(_container_workspace_label "$name")
  local container_agent; container_agent=$(_container_agent_label "$name")
  [[ "$container_agent" == "claude" || "$container_agent" == "codex" ]] || _die "$name has no valid agent label"
  local container_iso; container_iso=$(_container_iso_label "$name")
  [[ "$container_iso" == "default" || "$container_iso" == "worktree" || "$container_iso" == "strict" ]] || _die "$name has no valid isolation label"
  docker rm -f "$name" >/dev/null
  _info "stopped $name"

  # Purge: remove the worktree and/or strict volumes too. Without
  # --purge, those persist so a later `agent-sandbox` reattaches to
  # the same state (--strict's whole point) or the same worktree.
  if (( purge )); then
    case "$container_iso" in
      worktree)
        # Recover the original repo from worktree metadata.
        if [[ -z "$repo" ]]; then
          # Best effort: ask the user to pass the path; we don't store it.
          _warn "purge: pass the repo path via 'agent-sandbox stop --purge <name>' from inside the repo"
        else
          AGENT_KIND="$container_agent"
          local wt; wt=$(_worktree_path "$repo" "$name")
          if [[ -d "$wt" ]]; then
            git -C "$repo" worktree remove --force "$wt" 2>/dev/null \
              || rm -rf "$wt"
            _info "removed worktree $wt"
          fi
        fi
        ;;
      strict)
        local ws cl
        ws="${name}-ws"
        cl="${name}-cl"
        docker volume rm "$ws" "$cl" 2>/dev/null || true
        _info "removed volumes $ws $cl"
        ;;
    esac
  fi
}

# --strict export: git-fetch the volume's branches into the host repo
# under refs/sandbox-export/* so the user can review and merge at their
# own pace. Only committed history transfers; uncommitted working-tree
# changes do not (commit them first inside the sandbox).
cmd_export() {
  _require_docker
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    local repo; repo=$(_resolve_repo)
    local matches; matches=$(_containers_for_target "$repo" "strict" "")
    [[ -z "$matches" ]] && _die "no --strict sandbox for $repo"
    local count; count=$(printf '%s\n' "$matches" | grep -c .)
    if (( count == 1 )); then
      name="$matches"
    else
      command -v fzf >/dev/null 2>&1 \
        || _die "$count strict sandboxes here; pass one explicitly"
      name=$(printf '%s\n' "$matches" \
        | fzf --height 40% --reverse --prompt 'export> ' --no-info)
      [[ -z "$name" ]] && exit 0
    fi
  fi
  case "$name" in
    *-strict|*-strict-[0-9]*|*-strict-*) ;;
    *) _die "export only applies to --strict sandboxes; '$name' is not one" ;;
  esac
  local ws="${name}-ws"
  docker volume inspect "$ws" >/dev/null 2>&1 || _die "volume $ws not found"

  local host_repo
  host_repo=$(docker volume inspect "$ws" -f '{{ index .Labels "agent-sandbox.host-repo" }}' 2>/dev/null)
  [[ -n "$host_repo" && -d "$host_repo/.git" ]] \
    || _die "could not resolve host repo from $ws label, or repo is not a git repo"

  if _container_running "$name"; then
    _warn "container $name is running; export reflects only committed history"
  fi

  _info "fetching from $ws into $host_repo as refs/sandbox-export/*"
  docker run --rm \
    -v "$host_repo":/host \
    -v "$ws":/sandbox:ro \
    "$IMAGE" \
    git -C /host fetch /sandbox 'refs/heads/*:refs/sandbox-export/*' --tags --force --no-write-fetch-head

  _info "review:  git -C $host_repo for-each-ref refs/sandbox-export/"
  _info "diff:    git -C $host_repo diff <branch>..refs/sandbox-export/<branch>"
  _info "merge:   git -C $host_repo merge refs/sandbox-export/<branch>"
  _info "drop:    git -C $host_repo for-each-ref --format='delete %(refname)' refs/sandbox-export/ | git -C $host_repo update-ref --stdin"
}

cmd_list() {
  _require_docker
  local out
  out=$(docker ps -a --filter "name=^${NAME_PREFIX}-" \
    --format '{{.Names}}\t{{.Status}}\t{{.Label "agent-sandbox.workspace"}}')
  if [[ -z "$out" ]]; then _info "no sandboxes"; return 0; fi
  printf '%s%-40s %-25s %s%s\n' "$C_BOLD" NAME STATUS WORKSPACE "$C_RESET"
  printf '%s\n' "$out" | column -t -s $'\t'
}

cmd_info() {
  _row "Image:"  "$IMAGE"
  if _image_built; then
    local id; id=$(docker image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null | cut -c8-19)
    _row "Built:" "$id"
  else
    _row "Built:" "${C_YELLOW}not built${C_RESET}"
  fi
  local current stored
  current=$(_dockerfile_hash 2>/dev/null || echo "?")
  stored=$(cat "$(_built_hash_file)" 2>/dev/null || echo "?")
  if [[ "$current" == "$stored" ]]; then
    _row "Hash:"  "$current"
  else
    _row "Hash:"  "${C_YELLOW}$current (current) != $stored (built)${C_RESET}"
  fi
  _row "Cache:" "$CACHE_DIR"
  echo
  cmd_list
}

cmd_rebuild() {
  _require_docker
  local dir; dir=$(_dockerfile_dir)
  _info "docker build --no-cache -t $IMAGE $dir"
  docker build --no-cache -t "$IMAGE" "$dir"
  _dockerfile_hash > "$(_built_hash_file)"
}

# LaunchAgent path: per-repo, keyed by an 8-char path hash so multiple
# repos can be autostarted independently.
_plist_path() {
  local repo="$1"
  local hash; hash=$(printf '%s\n%s' "$repo" "$AGENT_KIND" | shasum -a 256 | cut -c1-8)
  printf '%s/Library/LaunchAgents/dev.sakakibara.agent-sandbox.%s.%s.plist\n' "$HOME" "$AGENT_KIND" "$hash"
}

cmd_enable_autostart() {
  local repo plist self
  repo=$(_resolve_repo "${1:-}")
  plist=$(_plist_path "$repo")
  self=$(command -v agent-sandbox) || _die "agent-sandbox not on PATH"
  mkdir -p "$(dirname "$plist")" "$CACHE_DIR"

  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(basename "$plist" .plist)</string>
  <key>ProgramArguments</key>
  <array>
    <string>$self</string>
    <string>$AGENT_KIND</string>
    <string>start</string>
    <string>$repo</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$CACHE_DIR/autostart.log</string>
  <key>StandardErrorPath</key>
  <string>$CACHE_DIR/autostart.log</string>
</dict>
</plist>
EOF
  launchctl load "$plist" 2>/dev/null || true
  _info "autostart enabled for $repo"
  _info "plist: $plist"
}

cmd_disable_autostart() {
  local repo plist
  repo=$(_resolve_repo "${1:-}")
  plist=$(_plist_path "$repo")
  if [[ -f "$plist" ]]; then
    launchctl unload "$plist" 2>/dev/null || true
    rm -f "$plist"
    _info "autostart disabled for $repo"
  else
    _info "no autostart plist for $repo"
  fi
}

cmd_help() {
  cat <<'EOF'
agent-sandbox - Docker-isolated coding agents.

Usage:
  agent-sandbox [claude|codex] [PERM] [ISO] [repo] [-- AGENT ARGS]
  agent-sandbox [claude|codex] start [PERM] [ISO] [repo] [-- AGENT ARGS]
  agent-sandbox [claude|codex] new [PERM] [ISO] [--name X] [repo] [-- AGENT ARGS]
                                            alias for the default; always
                                            creates a fresh sandbox (auto-
                                            numbered: <base>, <base>-2, ...)
  agent-sandbox run-untrusted [--image IMAGE] [repo] -- COMMAND
                                            run untrusted repository code in
                                            a disposable, networkless volume
  agent-sandbox stop [--purge] [name]      stop & remove (cwd-scoped picker
  agent-sandbox stop --all-here              for cwd repo, with mode
  agent-sandbox stop --all                   --all-here / --all variants)
  agent-sandbox stop --relay               stop the host-side 1Password
                                            agent socat relay (persists
                                            across sandboxes by default;
                                            this is the explicit stop)
  agent-sandbox export [name]              --strict only: git-fetch volume
                                            branches into the host repo
                                            as refs/sandbox-export/*
  agent-sandbox list                       all sandboxes (with workspace col)
  agent-sandbox info                       image + sandbox status
  agent-sandbox rebuild                    docker build --no-cache
  agent-sandbox enable-autostart [repo]    LaunchAgent: start at login
  agent-sandbox disable-autostart [repo]
  agent-sandbox help

Naming:
  Containers: agent-sandbox-<base>[-codex][-wt|-strict][-name | -N]
    base   = sanitized repo basename
    agent  = -codex for Codex (Claude has no agent suffix)
    mode   = -wt | -strict (default mode has no mode suffix)
    name   = sanitized --name X (named slot)
    N      = auto-bumped integer (parallel sessions; cross-repo collision)

  iOS labels: 🛡 <base>[-codex][-mode][-name | -N] (or 🛡 <X> with --name)

  Cross-repo basename collision: first repo to claim `<base>` wins; the
  second auto-bumps to `<base>-2`. Detected via the workspace label set
  on each container.

Permission modes (PERM):
  --auto      (default) acceptEdits mode; prompts on high-risk operations
  --bypass    no permission prompts; explicit opt-in for trusted work

Agent selection:
  agent-sandbox claude  run Claude Code; supports every isolation mode
  agent-sandbox codex   run Codex; supports default and --worktree
  Omitting the agent selects Claude.

Optional capabilities:
  --repo-setup  trusted repos only: run setup and mise install at startup
  --signing     forward the host signing agent and Git identity configuration

Agent passthrough:
  [repo] -- ARGS           everything after -- is appended to the agent's
                           own argument list verbatim, e.g.
                           `agent-sandbox . -- --debug`. A positional repo
                           is required before -- (use . for the cwd).

Resume passthrough:
  --continue, -c           continue the most recent session in the cwd
  --resume [SESSION]       resume a session by UUID or name, or open the
                           picker if omitted. Use --resume=NAME when NAME
                           is also a directory.

Multi-repo (default mode only):
  --workspace PATH [PATH ...]   bind-mount each PATH at its host path
                                inside the container. The first path is
                                primary (cwd inside the container, container-
                                name source, iOS label source). All
                                subsequent paths are slurped until the next
                                --flag (use `--` to terminate before a
                                positional). Order is significant: the same
                                paths in the same order produce the same
                                container name and iOS label; a different
                                order is a different sandbox. Not compatible
                                with --worktree or --strict.

Isolation modes (ISO):
  (default)   bind-mount cwd at its host path. For Claude the agent state
              directory is a per-slot sandbox-owned copy: host settings,
              instructions, hooks, skills and plugin code are read-only or
              not shared at all, and only projects/ (session history) and
              .credentials.json are writable host paths. Codex state stays
              fully RW. Risk: the agent can delete the cwd.
              Directory symlinks in the workspace (depth 2) are resolved and
              their targets mounted too, so a view assembled from links - a
              hub project's code/, docs/, assets/ - works without naming each
              path. A link to the host home is never followed.

  --worktree  bind-mount a fresh `git worktree add` at the host repo path.
              Main checkout is unreachable from the container. Agent state
              is handled exactly as in default mode.
              Cheap "just in case" upgrade; one extra arg.

  --strict    the host repo path is a docker volume seeded from the cwd repo.
              ~/.claude is a docker volume seeded once from host ~/.claude.
              The only host bind mount is ~/.agents read-only, so the
              configured hooks still run; --signing adds the Git config.
              Host repo and host ~/.claude cannot be written by the
              container at all.
              Use `agent-sandbox export` to git-fetch changes back to
              the host repo as refs/sandbox-export/*; review and merge
              at your own pace.

Untrusted execution:
  run-untrusted copies the repository into a disposable 4 GiB in-memory
  workspace and runs COMMAND with no network, credentials, agent state,
  signing socket, or writable host mount. CPU, memory, and process counts
  are bounded, and the workspace disappears with the container.

Lifecycle: containers are ephemeral and disappear when the selected agent
exits. Claude sessions can detach with Ctrl-p Ctrl-q and continue through
Claude remote control. Codex sessions have no remote-control detach path.
Resume a past conversation in a fresh container with --continue / --resume.
EOF
}

main() {
  if [[ "${1:-}" == "claude" || "${1:-}" == "codex" ]]; then
    AGENT_KIND="$1"
    shift
  fi
  local sub="${1:-}"
  case "$sub" in
    new)                shift; cmd_default "$@" ;;
    run-untrusted)      shift; cmd_run_untrusted "$@" ;;
    start)              shift; cmd_start "$@" ;;
    stop)               shift; cmd_stop "$@" ;;
    export)             shift; cmd_export "$@" ;;
    list|ls)            shift; cmd_list "$@" ;;
    info|status)        shift; cmd_info "$@" ;;
    rebuild)            shift; cmd_rebuild "$@" ;;
    enable-autostart)   shift; cmd_enable_autostart "$@" ;;
    disable-autostart)  shift; cmd_disable_autostart "$@" ;;
    help|-h|--help)     cmd_help ;;
    *)                  cmd_default "$@" ;;
  esac
}

main "$@"
