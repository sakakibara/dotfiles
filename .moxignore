# mox ignore (gitignore syntax; paths relative to $HOME).
# Keeps credentials and machine-local state out of the synced repo.
# Delete a line to track it (e.g. if the repo is private).

# Claude Code: the configuration files are added explicitly. Everything
# here is credentials, caches, and session data that must never be
# committed.
.claude/.credentials.json
.claude/*.jsonl
.claude/*-cache.json
.claude/settings.local.json
.claude/projects/
.claude/file-history/
.claude/sessions/
.claude/shell-snapshots/

# Codex: same shape. Shared agent instructions, skills and hook
# implementations live under .agents/, which is tracked in full.
.codex/auth.json
.codex/*.json
.codex/*.jsonl
.codex/*.sqlite*
.codex/cache/
.codex/generated_images/
.codex/sessions/
.codex/shell_snapshots/
.codex/tmp/

!.codex/hooks.json

# Python bytecode. Importing a hook module from the source tree, as the
# test suites do, drops a __pycache__ beside it; it is machine- and
# interpreter-specific, so mox must never carry it between machines.
__pycache__/
*.pyc
# Emacs flycheck writes a scratch copy beside the file it checks.
flycheck_*

# SSH / signing keys
.ssh/id_*
!.ssh/id_*.pub
*.pem

# Windows-only shims: PowerShell/batch scripts. On macOS/Linux the
# extensionless (bash) versions are used, so ignore these there.
# mox: when os=darwin or os=linux
*.ps1
*.cmd
# mox: end

# opencode: providers and models are machine-local. The tracked
# opencode.jsonc carries only settings that are safe to publish.
.config/opencode/config.json
.config/opencode/auth.json
